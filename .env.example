# Copy to .env (git-ignored) and fill in. Never commit real secrets.
# Postgres superuser (used once by init-db.sh, then services use their own roles)
POSTGRES_USER=arena_admin
POSTGRES_PASSWORD=change-me
# Per-service databases and least-privilege roles (ADR-0002)
CORE_DB_NAME=core_db
CORE_DB_USER=core_user
CORE_DB_PASSWORD=change-me
GAME_DB_NAME=game_db
GAME_DB_USER=game_user
GAME_DB_PASSWORD=change-me
CHAT_DB_NAME=chat_db
CHAT_DB_USER=chat_user
CHAT_DB_PASSWORD=change-me
# Internal service ports (compose network only; browsers use Nginx)
CORE_PORT=3001
GAME_PORT=3002
CHAT_PORT=3003
# Dev/test identity and direct-match fixture only; keep false outside local E2E.
DEV_PRINCIPAL=false
# Local Game process default. Docker Compose overrides this to `worker` and
# sends judging through the private judge-worker service.
JUDGE_BACKEND=container
# Internal Game ↔ worker bearer secret. Compose passes it only to Game and
# judge-worker. Replace before sharing/deploying.
JUDGE_WORKER_TOKEN=replace-with-a-random-64-character-secret
JUDGE_WORKER_TIMEOUT_MS=930000
# Single-host worker capacity: two running GameJudge calls and eight waiting.
JUDGE_WORKER_CONCURRENCY=2
JUDGE_WORKER_MAX_QUEUE=8
JUDGE_WORKER_QUEUE_TIMEOUT_MS=30000
JUDGE_WORKER_JOB_TIMEOUT_MS=900000
# The worker pulls missing images through its Docker socket at startup.
JUDGE_PYTHON_IMAGE=python:3.12-slim
JUDGE_GCC_IMAGE=gcc:14-bookworm
# Linux default. On Docker Desktop, use the absolute host path to its socket
# if /var/run/docker.sock is not available to Compose.
JUDGE_DOCKER_SOCKET=/var/run/docker.sock
# Optional Judge0 adapter (not selected by Compose).
JUDGE0_URL=http://judge0-server:2358
JUDGE0_AUTH_TOKEN=
JUDGE0_C_LANGUAGE_ID=50
JUDGE0_CPP_LANGUAGE_ID=54
JUDGE0_PYTHON_LANGUAGE_ID=71
JUDGE0_POLL_INTERVAL_MS=250
JUDGE0_MAX_POLLS=120
