  "milestones": [
    {
      "id": "M00",
      "title": "See the destination",
      "why": "**See the destination.** Play/watch one reference journey; identify Match, Round, Problem, Run, Submit, Reveal; locate browser, server, storage, and Judge on a simple map. Distinguish reference from practice and team workspaces.",
      "enables": "Know what the game does before creating files.",
      "prerequisites": [],
      "lessonIds": [
        "m00-destination",
        "m00-workspaces"
      ],
      "content": "content/M00.json"
    },
    {
      "id": "M01",
      "title": "Set up a practice workspace",
      "why": "**Set up a practice workspace.** Explain root/current directory, editor, terminal, Git status, Node, package manager, package manifest, dependency install, TypeScript tools, and the first run command. Verify versions and each command before proceeding.",
      "enables": "Run one function in your own practice folder.",
      "prerequisites": [
        "M00"
      ],
      "lessonIds": [
        "m01-tools",
        "m01-folder",
        "m01-package",
        "m01-first-run"
      ],
      "content": "content/M01.json"
    },
    {
      "id": "M02",
      "title": "Move from C to TypeScript and tests",
      "why": "**Move from C to TypeScript and tests.** Functions/parameters/returns; annotations and type erasure; `number` versus C integer types; booleans/strings; objects and arrays; unions, missing values, imports/exports, and basic errors as needed. Explain a test as a function call plus an expected result.",
      "enables": "Test a boundary and explain a changed case.",
      "prerequisites": [
        "M01"
      ],
      "lessonIds": [
        "m02-boundary",
        "m02-types-runtime",
        "m02-records",
        "m02-modules",
        "m02-transfer"
      ],
      "content": "content/M02.json"
    },
    {
      "id": "M03",
      "title": "Represent the game and change its state",
      "why": "**Represent the game and change its state.** Player/side IDs, Match/Round records, allowed phase transitions, membership, injected time, and the difference between a pure decision and a state change. Introduce interfaces as contracts when the first substitute is needed.",
      "enables": "Represent a Match and reject an invalid action.",
      "prerequisites": [
        "M02"
      ],
      "lessonIds": [
        "m03-records",
        "m03-transitions",
        "m03-membership",
        "m03-clock"
      ],
      "content": "content/M03.json"
    },
    {
      "id": "M04",
      "title": "Give players a Problem and a visible Run",
      "why": "**Give players a Problem and a visible Run.** Problem data and validation; statement/starter languages; separate visible and hidden data; a fake Judge; a Run request and result. Introduce promises/`async`/`await` and error paths around this concrete dependency.",
      "enables": "Run public examples without changing the score.",
      "prerequisites": [
        "M03"
      ],
      "lessonIds": [
        "m04-problem",
        "m04-judge-port",
        "m04-run"
      ],
      "content": "content/M04.json"
    },
    {
      "id": "M05",
      "title": "Submit, evaluate, score, and reveal",
      "why": "**Submit, evaluate, score, and reveal.** Acceptance and pending receipt; request identity and duplicate protection; fake-Judge success/failure; counted scores; normal Reveal; Round resets; summed Match scores and tie-breaks; Match deadline and bounded reveal grace. Teach these as separate slices.",
      "enables": "Finish a local Match with tested scoring and deadlines.",
      "prerequisites": [
        "M04"
      ],
      "lessonIds": [
        "m05-accept",
        "m05-pending",
        "m05-retry",
        "m05-score",
        "m05-reveal",
        "m05-round-reset",
        "m05-final-result",
        "m05-deadline",
        "m05-complete-match"
      ],
      "content": "content/M05.json"
    },
    {
      "id": "M06",
      "title": "Expose a small server API",
      "why": "**Expose a small server API.** Process/port; HTTP request/response; JSON; route/controller/service; runtime input validation; trusted identity seam; status/error responses. Explain the reference framework's modules and dependency injection only as the small route needs them.",
      "enables": "Call your rules through a small server API.",
      "prerequisites": [
        "M05"
      ],
      "lessonIds": [
        "m06-http",
        "m06-controller",
        "m06-validation",
        "m06-identity"
      ],
      "content": "content/M06.json"
    },
    {
      "id": "M07",
      "title": "Build the screen around working behavior",
      "why": "**Build the screen around working behavior.** HTML/CSS and browser events; then TypeScript components, props/state, rendering, effects/cleanup, forms, editor integration, and requests. Begin with one input/button/result; expand to Problem/editor/Run/Submit/Reveal/final result. Introduce a transport interface when separating the screen from the connection.",
      "enables": "Use one browser to play through your local game.",
      "prerequisites": [
        "M06"
      ],
      "lessonIds": [
        "m07-browser-basics",
        "m07-react-state",
        "m07-transport",
        "m07-editor-run",
        "m07-submit-reveal",
        "m07-local-journey"
      ],
      "content": "content/M07.json"
    },
    {
      "id": "M08",
      "title": "Save and recover the game",
      "why": "**Save and recover the game.** Memory store versus database; schema/relations and JSONB where used; persistence interface and Postgres adapter; transactions/revisions; durable evaluation ownership; work outside short locks; restart and failed-write recovery; publish events only after commit.",
      "enables": "Recover saved state and reject stale writes.",
      "prerequisites": [
        "M05",
        "M06",
        "M07"
      ],
      "lessonIds": [
        "m08-store-port",
        "m08-postgres",
        "m08-transactions",
        "m08-claims",
        "m08-events",
        "m08-recovery"
      ],
      "content": "content/M08.json"
    },
    {
      "id": "M09",
      "title": "Run code through the real Judge boundary",
      "why": "**Run code through the real Judge boundary.** First explain why player programs need isolation. Connect explicit provider selection, worker API, per-case containers, languages, limits, sealed data, queue/readiness, and infrastructure failures. Compare real results with the fake-Judge contract.",
      "enables": "Run player programs through an isolated Judge.",
      "prerequisites": [
        "M08"
      ],
      "lessonIds": [
        "m09-isolation",
        "m09-provider",
        "m09-case-runner",
        "m09-worker",
        "m09-replace-fake"
      ],
      "content": "content/M09.json"
    },
    {
      "id": "M10",
      "title": "Create a private Lobby and connect two players",
      "why": "**Create a private Lobby and connect two players.** Invite code, side assignment, Ready and host Start; durable Match creation; HTTP versus socket events; trusted socket identity; membership, revisions, first/last-socket presence, stale replies, disconnect/reconnect, and authoritative refresh.",
      "enables": "Invite a second player and recover after reconnect.",
      "prerequisites": [
        "M07",
        "M08",
        "M09"
      ],
      "lessonIds": [
        "m10-invite",
        "m10-start",
        "m10-socket-auth",
        "m10-presence",
        "m10-reconnect",
        "m10-two-clients"
      ],
      "content": "content/M10.json"
    },
    {
      "id": "M11",
      "title": "Make 2v2 safe and understandable",
      "why": "**Make 2v2 safe and understandable.** Team membership; shared document and revisions; collaboration protocol; round-scoped clients; both-player readiness; readiness invalidation after edits; submission of the agreed document snapshot.",
      "enables": "Keep two teams\u2019 code and readiness separate.",
      "prerequisites": [
        "M10"
      ],
      "lessonIds": [
        "m11-document",
        "m11-ready",
        "m11-round-lifetime",
        "m11-four-clients"
      ],
      "content": "content/M11.json"
    },
    {
      "id": "M12",
      "title": "Add Game-owned team chat and client cleanup",
      "why": "**Add Game-owned team chat and client cleanup.** Match scope versus Round scope; chat membership and team isolation; messages/pings; history limits and errors; preservation/disposal of chat and collaboration clients.",
      "enables": "Chat with teammates and clean up old clients.",
      "prerequisites": [
        "M11"
      ],
      "lessonIds": [
        "m12-chat",
        "m12-sidecars",
        "m12-live-chat"
      ],
      "content": "content/M12.json"
    },
    {
      "id": "M13",
      "title": "Integrate, operate, and prove the complete game",
      "why": "**Integrate, operate, and prove the complete game.** Team-repo mapping; real identity/navigation/configuration contracts; Docker/Compose, environment examples, private worker, Nginx/TLS, service readiness, real multiplayer browser journeys, error recovery, README/contributions, and behavior-by-behavior comparison with the reference.",
      "enables": "Check your implementation inside the team app.",
      "prerequisites": [
        "M12"
      ],
      "lessonIds": [
        "m13-inspect-team",
        "m13-map-rule",
        "m13-integrate",
        "m13-compose",
        "m13-tls",
        "m13-parity",
        "m13-handover"
      ],
      "content": "content/M13.json"
    }
  ],
