{
  "name": "code-arena",
  "version": "0.1.0",
  "description": "Code Arena production monorepo (ticket 01).",
  "private": true,
  "type": "commonjs",
  "workspaces": [
    "packages/*",
    "services/*",
    "frontend"
  ],
  "scripts": {
    "dev": "vite frontend -c frontend/vite.config.ts",
    "build": "npm run build --workspace=arena-model && npm run build --workspace=arena-frontend",
    "build:all": "npm run build --workspaces --if-present",
    "pretest": "npm run build",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "certs": "bash scripts/gen-dev-certs.sh",
    "up": "docker compose up --build",
    "down": "docker compose down"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.28.2",
    "highlight.js": "^11.12.0",
    "lint-staged": "^17.6.0",
    "playwright": "^1.63.0",
    "playwright-core": "1.63.0",
    "prettier": "^3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "^5.9.2",
    "vite": "7.3.6"
  },
  "overrides": {
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "vite": "7.3.6",
    "playwright-core": "1.63.0"
  }
}
