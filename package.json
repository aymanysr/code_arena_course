{
  "name": "code-arena",
  "version": "0.1.0",
  "description": "Code Arena production monorepo (ticket 01).",
  "private": true,
  "type": "commonjs",
  "workspaces": [
    "packages/*",
    "services/*",
    "frontend"
  ],
  "scripts": {
    "pretest": "npm run build",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "certs": "bash scripts/gen-dev-certs.sh",
    "up": "docker compose up --build",
    "down": "docker compose down",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "esbuild": "0.28.2",
    "highlight.js": "^11.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9"
  }
}
